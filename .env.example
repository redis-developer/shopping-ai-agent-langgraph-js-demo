SERVER_PORT=3000
NODE_ENV=development
APP_NAME="Redish"

# Optional: used for the GitHub links in the pages (defaults to the main repository). Set it if you run your own fork.
#GITHUB_URL="https://github.com/your_account/your_repository"

# Which AI provider to use: "openai" or "aws-bedrock" (default: openai)
# Install its package first: npm run install:openai  or  npm run install:aws-bedrock
AI_PROVIDER="openai"

# OpenAI (when AI_PROVIDER="openai")
OPENAI_API_KEY="your_openai_api_key"
MODEL_NAME="gpt-4o-mini"

# AWS Bedrock (when AI_PROVIDER="aws-bedrock")
BEDROCK_AWS_ACCESS_KEY_ID="your_aws_access_key_id"
BEDROCK_AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
BEDROCK_AWS_REGION="us-east-1"
BEDROCK_MODEL_ID="global.anthropic.claude-opus-4-7"  # Optional: this is the default

# AWS Bedrock Guardrails (when AI_PROVIDER="aws-bedrock")
BEDROCK_CONVERSATION_GUARDRAIL_ID="your_conversation_guardrail_id"
BEDROCK_CACHE_GUARDRAIL_ID="your_cache_guardrail_id"
BEDROCK_GUARDRAIL_VERSION="1"

# Redis (stores products, vectors and carts)
REDIS_URL="redis://default:your_password@your_redis_host:your_redis_port"

# Redis Agent Memory (@redis-iris/agent-memory)
AGENT_MEMORY_URL="your_agent_memory_endpoint"
AGENT_MEMORY_STORE_ID="your_store_id"
AGENT_MEMORY_API_KEY="your_agent_memory_api_key"
#AGENT_MEMORY_NAMESPACE_ID="your_namespace_id"  # Optional: scope memories to a namespace

# Redis LangCache (semantic cache)
LANGCACHE_API_KEY="your_langcache_api_key"
LANGCACHE_API_BASE_URL="your_langcache_api_base_url"
LANGCACHE_CACHE_ID="your_langcache_cache_id"

# LangSmith tracing (optional; read by LangChain itself, not by the app code)
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your_langsmith_api_key"
LANGSMITH_PROJECT="your_langsmith_project"
