{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["src/client", "node_modules"]
}
